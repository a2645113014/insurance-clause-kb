# ============================================================
# 保险条款知识库与合规审查 Agent —— 环境变量模板
# 复制为 .env 后按注释填写。.env 已在 .gitignore 中，绝不会入库。
# ============================================================

# ------------------------------------------------------------
# 1. 大模型服务（阿里云百炼，OpenAI 兼容协议）
#    api_key 申请：https://bailian.console.aliyun.com/
# ------------------------------------------------------------
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# 生成模型。注意 qwen-max 是非思考模型，不支持 enable_thinking，也不支持图像输入
LLM_DEFAULT_MODEL=qwen-max
# 视觉模型：图片摘要走它（qwen-max 不支持图像，故单独配置）
VL_MODEL=qwen3-vl-flash
LLM_DEFAULT_TEMPERATURE=0.1

# ------------------------------------------------------------
# 2. Milvus（向量库）
#    ⚠️ 前缀 insurance_ 是隔离刚需：同一实例可能被其他知识库项目共用，
#       沿用旧集合名会造成双向污染。切勿把下面三项指回 kb_* 系列。
# ------------------------------------------------------------
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=insurance_clauses
CHUNKS_COLLECTION_LEGACY=kb_chunks
ITEM_NAME_COLLECTION=insurance_item_names
ENTITY_NAME_COLLECTION=insurance_entities
EMBEDDING_DIM=1024

# ------------------------------------------------------------
# 3. MongoDB（规则表 / 合规清单 / 会话历史）
#    ⚠️ 独立库名同样是隔离刚需：共用库名会让会话历史串库。
# ------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=insurance_kb
RULE_COLLECTION=insurance_rules
COMPLIANCE_COLLECTION=compliance_rules

# ------------------------------------------------------------
# 4. MinIO（对象存储，存放 PDF 解析出的表格与插图）
# ------------------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ------------------------------------------------------------
# 5. Neo4j（已配置但当前未接入，可留空）
# ------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_ME

# ------------------------------------------------------------
# 6. 本地模型权重
#    bge-m3 约 2.3 GB，bge-reranker-large 约 1.3 GB
# ------------------------------------------------------------
BGE_M3_PATH=/path/to/bge-m3
BGE_M3=BAAI/bge-m3
BGE_RERANKER_LARGE=/path/to/bge-reranker-large
# CPU 上必须 BGE_FP16=0（FP16 仅 GPU 加速用）
BGE_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0
# 模型下载缓存目录（走 modelscope 时可设 MODELSCOPE_CACHE）
HF_HOME=/path/to/hf_cache
MODELSCOPE_CACHE=/path/to/modelscope_cache
MODELSCOPE_OFFLINE=0
MINERU_MODEL_SOURCE=modelscope

# ------------------------------------------------------------
# 7. 导入链路
# ------------------------------------------------------------
# Markdown 中间件产物目录（按 task_id 生成，不入库）
MD_ROOT_DIR=./temp-files/
# MinerU 云端解析兜底（主路是本地 PyMuPDF；仅字体缺失的 PDF 才走云）
MINERU_API_TOKEN=REPLACE_ME
MINERU_BASE_URL=https://mineru.net/api/v4

# ------------------------------------------------------------
# 8. 检索层参数（消融实验开关面板）
#    读取方：app/conf/retrieval_config.py
#    改完必须重启服务才生效（模块导入时读一次）
# ------------------------------------------------------------
# 混合检索加权：(稠密, 稀疏)，各自须落在 [0,1]
# 消融结论（276 题 grounded 标注集）：0.8/0.2、0.6/0.4、0.5/0.5 三组差异 ≤0.7pp，
# 属等价解 —— 权重不是本语料的有效杠杆，保持 0.8/0.2。
RANKER_WEIGHTS=0.8,0.2
# HyDE 分支总开关。消融：开 R@1 0.7391 / R@3 0.9203；关（退化为单路）R@1 0.7138 / R@3 0.8659。
# 增益集中在 Recall@3（+5.4pp），保留开启。
HYDE_ENABLED=true
# 混合检索最终返回条数 / 单路（稠密、稀疏）各自召回条数（后者须 >= 前者）
RETRIEVAL_LIMIT=5
RETRIEVAL_REQ_LIMIT=10
# 断崖式动态 TopK 的四个阈值
# 注：reranker 返回的是 logits，RERANK_GAP_ABS 在 logits 空间几乎永不触发，
#     真正起作用的是 RERANK_GAP_RATIO —— 做消融别只盯 gap_abs。
RERANK_MAX_TOPK=10
RERANK_MIN_TOPK=1
RERANK_GAP_RATIO=0.5
RERANK_GAP_ABS=2
# 联网检索参与方式（三态）：
#   off      完全不发起联网检索
#   fallback 照常检索，但仅当本地条款全未命中时才兜底（推荐）
#   always   与本地结果一起进上下文（改造前行为，仅留给消融做对照）
# 为什么默认 fallback：bge-reranker 对「网页标题 + 营销文风」系统性给正分
# （实测 +2.59~+3.81），对规范条款句式给负 logits（实测 -0.85~-7.32），
# 混池排序后联网软文恒定占 top1 → 模型拿营销文案当条款依据。
WEB_SEARCH_MODE=fallback
WEB_MAX_TOPK=2

# ------------------------------------------------------------
# 9. 规则层参数（Phase 2.3）
#    读取方：app/conf/rule_config.py
# ------------------------------------------------------------
# 规则工具总开关。false 时规则分支短路，查询图退化为纯检索链路
# —— 做「有工具 / 无工具」对照实验靠它
RULE_TOOL_ENABLED=true
# 产品级查不到时是否降级到险种级取同类产品通用材料。
# true：能答，但答案须标注「该产品条款未单列，以下为同类通用要求」
RULE_FALLBACK_TO_INSURANCE_TYPE=true
# 理赔意图关键词至少命中几个才触发规则分支（取 0 等于全量走规则，不要这么设）
RULE_MIN_KEYWORD_HITS=1
# 理赔意图关键词表（逗号分隔）。注释掉则用 rule_config.py 里的默认表
# RULE_INTENT_KEYWORDS=理赔材料,索赔材料,需要什么材料,多久能赔

# ------------------------------------------------------------
# 10. 合规审查层参数（Phase 3.2）
#     读取方：app/conf/compliance_config.py
# ------------------------------------------------------------
# 合规工具总开关。false 时合规分支短路，用于「有工具 / 无工具」对照
COMPLIANCE_TOOL_ENABLED=true
# 向量检索取前几条。给太少会漏掉适用条目（→ 误判合规），给太多会稀释判断（→ 误判违规）。
# ⚠️ 实测：当前兜底策略下这个旋钮是"死旋钮" —— 通用兜底有 59 条，一路就填满
#    COMPLIANCE_MAX_ITEMS，k6/k12/k24 输出条数全是 40。要它生效须先降 MAX_ITEMS 或关通用兜底。
COMPLIANCE_TOP_K=12
# 是否恒带 scope=通用 的条目。当前金标集（17 条）测不出它的长尾价值，
# 但合规场景漏检代价远大于多喂噪音 → 保持开启，扩量金标集后再评估。
COMPLIANCE_INCLUDE_UNIVERSAL=true
# 是否按产品险种补充 scope 匹配的条目。唯一真有取舍的旋钮：
# 关掉后全金标召回 1.0 → 0.9412（漏一条），但金标位次 2.82 → 1.69
COMPLIANCE_INCLUDE_SCOPE_MATCH=true
# 兜底后总条数上限，防止险种匹配过宽把 prompt 撑爆（超了按相似度截断）
COMPLIANCE_MAX_ITEMS=40

# ------------------------------------------------------------
# 11. 联网检索 MCP（百炼，Streamable HTTP 协议）
#     注意必须用新版 /mcp 端点，旧版 /sse 协议不兼容
# ------------------------------------------------------------
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ------------------------------------------------------------
# 12. 日志
# ------------------------------------------------------------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ------------------------------------------------------------
# 13. 调试开关
# ------------------------------------------------------------
# 产品名对齐诊断日志（打印候选与分数，排查跨产品召回时打开）
ITEM_NAME_DIAG=1
